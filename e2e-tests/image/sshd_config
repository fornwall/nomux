# Keys only, and no multiplexing anywhere: the matrix measures what happens at the
# *final* logout, so a second session held open by anything would suppress the very
# thing under test.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes

# Left explicitly on: pam_systemd is what creates the `session-N.scope` a directly
# launched daemon stays in, and the `CELL_PAM_SYSTEMD=no` cell turns it off in
# /etc/pam.d/common-session rather than here, so this axis has one switch.
UsePAM yes

# What ends the login in an `abrupt` cell, where the connection is blackholed and no FIN or
# RST will ever arrive to say so. Short so the matrix does not sit out an hour of TCP
# retransmission per cell; not so short that the timeout is hard to tell from an orderly
# close, which is the false pass `run.sh`'s TEARDOWN floor exists to catch. As set, sshd
# gives up 15-20s after the wire is cut against 0.1s for a close — measured, not assumed,
# and further apart than the two intervals here would suggest.
#
# Leaving these unset would not make the matrix stricter, it would make it vacuous: sshd
# would never ask, the login would outlive the connection indefinitely, and the abrupt cells
# would report `survives` having torn nothing down.
TCPKeepAlive yes
ClientAliveInterval 5
ClientAliveCountMax 1
